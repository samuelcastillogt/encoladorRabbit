# Puerto de la UI
PORT=3090

# Conexión AMQP (misma que RABBITMQ_URL de consumer-sap-dispatch)
RABBITMQ_URL=amqp://user:pass@host:5672

# (Opcional) API de management para listar colas existentes.
# Si se deja vacío se deriva de RABBITMQ_URL usando el puerto 15672.
RABBITMQ_MGMT_URL=
RABBITMQ_VHOST=/

# Colas sugeridas en el selector (separadas por coma)
PRESET_QUEUES=PRD-dispatch-sap-RE,PRD-dispatch-requeue-sap-RE

# Etiqueta visible del ambiente (DEV / QA / PRD)
ENV_LABEL=PRD
